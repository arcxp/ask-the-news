{
  "name": "ask-the-news",
  "private": true,
  "version": "1.0.0",
  "description": "Documentation and demo newsroom app for the Arc XP Ask The News experience",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arcxp/ask-the-news.git"
  },
  "type": "module",
  "workspaces": [
    "apps/*"
